# ==============================================================================
# ATLAS Technosoft - Backend Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="ATLAS Technosoft API"
APP_PORT=8000
APP_HOST="0.0.0.0"

# Frontend Origins for CORS (comma-separated if multiple)
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"

# ==============================================================================
# SAP Business One Service Layer Configuration
# ==============================================================================
# Base URL for Service Layer (must include /b1s/v1)
# Example: https://hana-b1-server.atlastechnosoft.com:50000/b1s/v1
SAP_BASE_URL="https://hana-b1-server.atlastechnosoft.com:50000/b1s/v1"

# SAP Company Database Name
SAP_COMPANY_DB="SBODEMOIN"

# Service Layer Credentials
SAP_USERNAME="manager"
SAP_PASSWORD="ChangeMeInProduction"

# SSL Certificate Verification (true for production, false only for self-signed dev)
SAP_VERIFY_SSL=true

# Connection & Session Timeouts
SAP_TIMEOUT_SECONDS=20.0
SAP_SESSION_TIMEOUT_MINUTES=25

# Mock SAP in local development if live SAP HANA server is not reachable
# Set to 'false' in production or when connected to real SAP Service Layer
MOCK_SAP_IN_DEV=true

# ==============================================================================
# Security & Rate Limiting
# ==============================================================================
RATE_LIMIT_PER_MINUTE=20
DUPLICATE_WINDOW_SECONDS=300

