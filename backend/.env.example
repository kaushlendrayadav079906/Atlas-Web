# ==============================================================================
# ATLAS Technosoft - Backend Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME="ATLAS Technosoft API"
APP_PORT=8000
APP_HOST="0.0.0.0"

# Frontend Origins for CORS (comma-separated if multiple)
# In production, specify exact domain: e.g. "https://atlastechnosoft.com,https://www.atlastechnosoft.com"
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000"

# ==============================================================================
# SAP Business One Service Layer Configuration
# ==============================================================================
# Base URL for Service Layer (must include /b1s/v1)
# Example: https://hana-b1-server.atlastechnosoft.com:50000/b1s/v1
SAP_BASE_URL="https://hana-b1-server.atlastechnosoft.com:50000/b1s/v1"

# SAP Company Database Name (e.g. SBODEMOIN, ATLAS_PROD)
SAP_COMPANY_DB="SBODEMOIN"

# Service Layer Credentials
SAP_USERNAME="manager"
SAP_PASSWORD="ChangeMeInProduction"

# SSL Certificate Verification (must remain 'true' in production)
SAP_VERIFY_SSL=true

# Connection & Session Timeouts
SAP_TIMEOUT_SECONDS=20.0
SAP_SESSION_TIMEOUT_MINUTES=25

# Mock fallback for offline / development environments
# IMPORTANT: Automatically disabled and rejected when APP_ENV == "production"
MOCK_SAP_IN_DEV=true

# ==============================================================================
# Security, Rate Limiting & Idempotency
# ==============================================================================
RATE_LIMIT_PER_MINUTE=20
DUPLICATE_WINDOW_SECONDS=300
IDEMPOTENCY_STORAGE=sqlite
IDEMPOTENCY_DB_PATH=""

# ==============================================================================
# Automated Email Notifications (SMTP)
# ==============================================================================
# Set to 'true' to enable automated email notifications on new form submissions
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@atlastechnosoft.com"
SMTP_PASSWORD="AppPasswordHere"
SMTP_FROM_EMAIL="sales@atlastechnosoft.com"
SMTP_FROM_NAME="ATLAS Technosoft Website"
NOTIFICATION_RECIPIENT_EMAILS="sales@atlastechnosoft.com"
SMTP_USE_TLS=true

# ==============================================================================
# Customer Support Chatbot & AI Knowledge Configuration
# ==============================================================================
# Rate limiting specifically for chatbot messages per client IP
CHATBOT_RATE_LIMIT_PER_MINUTE=30

# Live external LLM integration (OpenAI / Gemini)
# If disabled or credentials are omitted, the backend deterministically answers
# using the comprehensive verified ATLAS Technosoft Knowledge Base engine.
CHATBOT_AI_ENABLED=false
OPENAI_API_KEY=""
GEMINI_API_KEY=""
CHATBOT_MODEL="gpt-4o-mini"

